{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "https://github.com/${github_project}/"
  },
  "license": "MIT",
  "icon": "assets/create_tweaked_controllers/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.getitemfromblock.create_tweaked_controllers.fabric.TextBlockFabric"
    ],
    "client": [
      "io.github.slimeymc.text_block.fabric.TextBlockClientFabric"
    ]
  },
  "mixins": [
    "create_tweaked_controllers.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}"
  }
}